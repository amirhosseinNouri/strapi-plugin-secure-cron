{
  "version": "4.2.0",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "cron",
    "scheduler",
    "security",
    "rbac"
  ],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:admin && npm run test:integration",
    "test:unit": "jest --config jest.server.config.js",
    "test:admin": "jest --config jest.admin.config.js",
    "test:integration": "npm run build && jest --config jest.integration.config.js --runInBand",
    "docs:rules": "ts-node --transpile-only -P tsconfig.test.json scripts/gen-rules-doc.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@strapi/design-system": "^2.0.0-rc.14",
    "@strapi/icons": "^2.0.0-rc.14",
    "@tanstack/react-query": "^5.67.1",
    "@uiw/react-codemirror": "^4.23.7",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "diff": "^7.0.0",
    "node-schedule": "^2.1.1",
    "react-intl": "^7.1.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^5.3.0",
    "@strapi/strapi": "^5.12.3",
    "@strapi/typescript-utils": "^5.12.3",
    "@tanstack/eslint-plugin-query": "^5.66.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "styled-components": "^6.1.14",
    "typescript": "^5.7.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/diff": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node-schedule": "^2.1.7",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "^11.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  },
  "peerDependencies": {
    "@strapi/sdk-plugin": "^5.3.0",
    "@strapi/strapi": "^5.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "styled-components": "^6.1.14"
  },
  "strapi": {
    "name": "strapi-plugin-cron",
    "displayName": "Cron",
    "description": "Manage and monitor cron jobs from Strapi admin panel, with RBAC, script security checks and audit events.",
    "kind": "plugin"
  },
  "name": "strapi-plugin-secure-cron",
  "description": "Security-hardened cron jobs for the Strapi 5 admin panel: RBAC, script security checks, audit events and a real code editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amirhosseinNouri/strapi-plugin-cron.git"
  },
  "contributors": [
    {
      "name": "Amirhossein Nouri"
    },
    {
      "name": "mjnoach",
      "url": "https://github.com/mjnoach"
    },
    {
      "name": "Innovato",
      "email": "info@innovato.nl",
      "url": "https://innovato.nl"
    }
  ],
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "allowScripts": {
    "@swc/core@1.16.13": true,
    "better-sqlite3@11.10.0": true,
    "esbuild@0.20.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
